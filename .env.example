# Copy to .env in the directory where you run the CLI, then set your server URL.
# Existing environment variables take precedence over .env values.
QUERYTUBE_BASE_URL=https://querytube.example.com

# NotebookLM import runtime (login/setup is separate; existing session required).
# NOTEBOOKLM_CLI_PATH=/path/to/venv/bin/notebooklm
# NOTEBOOKLM_STORAGE_PATH=/path/to/storage_state.json
# NOTEBOOKLM_TIMEOUT_MS=60000
