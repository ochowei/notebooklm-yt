{
  "name": "notebooklm-yt",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first tool for importing selected QueryTube YouTube results into NotebookLM.",
  "type": "module",
  "bin": {
    "nlyt": "dist/cli/index.js"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.19.0",
    "eslint": "^10.12.0",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
