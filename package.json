{
  "name": "notebooklm-yt",
  "version": "0.2.0",
  "description": "A local-first tool for importing selected QueryTube YouTube results into NotebookLM.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ochowei/notebooklm-yt.git"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/**/*.js"
  ],
  "bin": {
    "nlyt": "dist/cli/index.js"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/cli/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "eslint": "^10.12.0",
    "globals": "^16.5.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.0",
    "yaml": "^2.9.1"
  }
}
